# Copia este archivo como backend/.env y ajusta los valores. El .env NO se sube a git.

# --- Servidor ---
PORT=3000

# --- Base de datos (XAMPP: root sin contraseña en el puerto 3306) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=dentalcare_bd
DB_CONNECTION_LIMIT=10

# --- JWT ---
# Mínimo 32 caracteres al azar. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si cambia, todas las sesiones abiertas dejan de servir (hay que volver a ingresar).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- CORS: orígenes del frontend, separados por coma (Live Server y el servidor de pruebas) ---
CORS_ORIGIN=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:5600,http://localhost:5600
